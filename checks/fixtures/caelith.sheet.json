    {
      "title": "Features",
      "entries": [
        {
          "label": "Low-Light Vision",
          "value": "Elf ancestry",
          "detail": "You can see in dim light as though it were bright light, so you ignore the concealed condition due to dim light."
        },
        {
          "label": "Whisper Elf",
          "value": "heritage",
          "detail": "Your ears are finely tuned. When you Seek, you gain a +2 circumstance bonus to locate undetected creatures within 30 feet, and your flat check to target concealed or hidden creatures is easier when the condition is due to sound."
        },
        {
          "label": "Nimble Elf",
          "value": "ancestry feat",
          "detail": "Your muscles are tightly honed. Your Speed increases by 5 feet."
        },
        {
          "label": "Reactive Strike",
          "value": "Fighter feature",
          "detail": "Reaction. Trigger: a creature within your reach uses a manipulate action or a move action, makes a ranged attack, or leaves a square during a move action it's using. Make a melee Strike against the triggering creature. If your attack is a critical hit and the trigger was a manipulate action, you disrupt that action. This Strike doesn't count toward your multiple attack penalty, and your multiple attack penalty doesn't apply to it."
        },
        {
          "label": "Shield Block",
          "value": "Fighter feature",
          "detail": "General feat (granted). Reaction. Trigger: while you have your shield raised, you would take physical damage from an attack. Your shield prevents damage up to its Hardness; you and the shield each take any remaining damage."
        },
        {
          "label": "Vicious Swing",
          "value": "class feat",
          "detail": "You unleash a particularly powerful attack. Make a melee Strike; it counts as two attacks for your multiple attack penalty. On a hit, deal one extra die of weapon damage."
        },
        {
          "label": "Assurance (Occultism)",
          "value": "skill feat — Scholar",
          "detail": "You devoted yourself to intensive study in a library or academy, mastering a scholarly tradition."
        }
      ]
    },
