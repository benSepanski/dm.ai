# AI Provider: "anthropic" (requires ANTHROPIC_API_KEY) or "claude_cli" (requires claude CLI on PATH)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here

# Model configuration
ORCHESTRATOR_MODEL=claude-sonnet-4-6
GENERATION_MODEL=claude-haiku-4-5-20251001

DATABASE_URL=postgresql+asyncpg://dmuser:dmpass@localhost:5432/dmdb
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:5173

# Token that unlocks the DM role in the UI and API (X-DM-Token header).
# Anyone without it is a player: read-only, with DM-only data redacted.
# Leave unset to have the API generate one per run (printed in its logs).
DM_TOKEN=pick-a-secret-for-your-table

# Context window management — trigger summarization at this token count,
# keeping the last N messages verbatim. Defaults shown; usually no need to change.
# CONTEXT_TOKEN_LIMIT=180000
# CONTEXT_PRESERVE_LAST_N=5

# Logging — DEBUG shows AI call details and token counts, INFO (default) is
# major events only. See dm_api/logging_config.py for the log line format.
# LOG_LEVEL=INFO
